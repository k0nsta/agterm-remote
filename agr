#!/usr/bin/env bash
# agr — agterm-remote
#
# Extend agterm's agent-status integration (sidebar colors + desktop pushes) to
# AI agents that run on a REMOTE host inside tmux, reached over SSH.
#
# One script, installed on both sides:
#   • the Mac (agterm) uses:  open | ls | kill | up | down | install | quick | doctor
#   • the remote host uses:   attach | sessions | reap | status | relay   (invoked by ssh / hooks)
#
# See README.md for the architecture. MIT licensed.

set -euo pipefail

VERSION="0.4.0"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agr"
# Remote paths, relative to the remote user's $HOME (resolved on the remote side).
REMOTE_BIN=".local/bin/agr"
REMOTE_SOCK=".cache/agterm/agterm.sock"

log()  { printf '%s\n' "$*" >&2; }
die()  { log "agr: $*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Session names and agterm session ids double as tmux session names and are
# interpolated into a remote command, so keep them to a safe character set.
valid_token() { case "$1" in ''|*[!a-zA-Z0-9_.-]*) return 1;; *) return 0;; esac; }

# remote_cmd <args...>
# Print the argv for invoking agr on the remote side, quoted for a remote
# shell. The leading $HOME is a literal for the remote login shell — it must
# NOT be expanded here — so it's a single-quoted constant, not $REMOTE_BIN
# (which is relative and already resolved against remote_home elsewhere).
remote_cmd() {
  local out='"$HOME/'"$REMOTE_BIN"'"' a
  for a in "$@"; do
    # shellcheck disable=SC2016
    out="$out $(printf '%q' "$a")"
  done
  printf '%s' "$out"
}

# remote_agr <host> <args...> — run agr on <host> via a non-login remote shell.
remote_agr() {
  local host="$1"; shift
  ssh "$host" -- "$(remote_cmd "$@")"
}

# The Mac's agterm control socket. agterm exports AGTERM_SOCKET into every
# session; fall back to the default install path when called from elsewhere.
local_sock() { printf '%s' "${AGTERM_SOCKET:-$HOME/Library/Application Support/agterm/agterm.sock}"; }

# Remote $HOME is needed for the -R forward (ssh will not expand remote env in
# the forward spec). Query it once per host and cache it.
remote_home() {
  local host="$1"; local f="$CACHE_DIR/home-$host"
  if [ -s "$f" ]; then cat "$f"; return 0; fi
  mkdir -p "$CACHE_DIR"
  local h; h="$(ssh "$host" 'printf %s "$HOME"')" || die "cannot reach host '$host'"
  [ -n "$h" ] || die "empty remote HOME for '$host'"
  printf '%s' "$h" > "$f"; printf '%s' "$h"
}

# remote_data <host> <args...>
# Run a data-returning remote command (sessions, reap), enforce the version
# handshake header, and print the remaining lines. A `die` here runs inside
# the caller's command substitution subshell — callers must propagate with
# `|| exit $?`.
remote_data() {
  local host="$1"; shift
  local out; local rc=0
  out="$(remote_agr "$host" "$@")" || rc=$?
  [ "$rc" -ne 255 ] || die "cannot reach '$host'"
  local header="${out%%$'\n'*}"
  case "$header" in
    agr$'\t'*) ;;
    *) die "remote agr on '$host' is missing or outdated — run: agr install $host";;
  esac
  local rv="${header#agr$'\t'}"
  [ "$rv" = "$VERSION" ] || log "agr: version mismatch (local $VERSION, $host $rv) — run: agr install $host"
  [ "$out" != "$header" ] || return 0
  printf '%s\n' "${out#*$'\n'}"
}

# humanize_secs <seconds> — compact age, e.g. 42s / 3m / 5h / 2d.
humanize_secs() {
  local s="$1"
  if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ];  then printf '%dm' $((s / 60))
  elif [ "$s" -lt 86400 ]; then printf '%dh' $((s / 3600))
  else                          printf '%dd' $((s / 86400))
  fi
}

# row_state <sid> — whether the agterm row bound to <sid> still exists.
# Looks the id up in $AGR_TREE, a newline-separated list of live session ids
# that `compute_agr_tree` fills once per invocation via `agtermctl tree --json`.
row_state() {
  local sid="$1"
  if [ "$sid" = "-" ] || ! have agtermctl; then
    printf -- '-'; return 0
  fi
  if printf '%s\n' "$AGR_TREE" | grep -qxF "$sid"; then
    printf 'bound'
  else
    printf 'stale'
  fi
}

# compute_agr_tree — fill $AGR_TREE with every live agterm session id, once
# per invocation. Empty (and row_state falls back to "-") when agtermctl is
# unavailable or the tree can't be parsed.
compute_agr_tree() {
  AGR_TREE=""
  have agtermctl || return 0
  AGR_TREE="$(agtermctl tree --json 2>/dev/null | python3 -c '
import sys, json
try:
    t = json.load(sys.stdin)["result"]["tree"]
except Exception:
    sys.exit(0)
for ws in t.get("workspaces", []):
    for s in ws.get("sessions", []):
        print(s["id"])
' 2>/dev/null)"
}

# pick_lines <rows> — one picker line per session: "name  cmd  row  idle".
# Requires $AGR_TREE to already be populated (compute_agr_tree).
pick_lines() {
  local rows="$1"
  local name windows attached idle_secs cmds sid
  while IFS=$'\t' read -r name windows attached idle_secs cmds sid; do
    printf '%s  %s  %s  %s\n' "$name" "$cmds" "$(row_state "$sid")" "$(humanize_secs "$idle_secs")"
  done <<< "$rows"
}

# ---------------------------------------------------------------------------
# LOCAL (Mac) subcommands
# ---------------------------------------------------------------------------

# agr open <host> <name>
# Adopt the current agterm session: relabel its row, ensure the control tunnel,
# then attach (or create) the named tmux session on the remote host.
cmd_open() {
  local host="${1:-}" name="${2:-}"
  [ -n "$host" ] || die "usage: agr open <host> <name>"

  if [ -z "$name" ]; then
    if ! have agtermctl; then
      cmd_ls "$host"
      die "usage: agr open <host> <name>"
    fi
    local rows; rows="$(remote_data "$host" sessions)" || exit $?
    compute_agr_tree
    local result
    result="$(pick_lines "$rows" | agtermctl pick open --allow-custom \
      --prompt "tmux session on $host — or type a new name")" || true
    [ -n "$result" ] || exit 1
    name="${result%% *}"
  fi
  valid_token "$name" || die "invalid name '$name' (use [A-Za-z0-9_.-])"
  local sid="${AGTERM_SESSION_ID:-}"
  [ -z "$sid" ] || valid_token "$sid" || die "invalid session-id '$sid' (use [A-Za-z0-9_.-])"

  # Relabel the sidebar row to the stable key (best-effort; only inside agterm).
  if [ -n "$sid" ] && have agtermctl; then
    agtermctl session rename "$name" --target "$AGTERM_SESSION_ID" >/dev/null 2>&1 || true
  fi

  cmd_up "$host"

  local rhome ragr ret=0
  rhome="$(remote_home "$host")"
  ragr="$rhome/$REMOTE_BIN"

  # Remember which host this agterm row is bound to, so `agr quick` can open a
  # remote shell overlay on it later.
  if [ -n "$sid" ]; then
    mkdir -p "$CACHE_DIR/session-host"
    printf '%s' "$host" > "$CACHE_DIR/session-host/$sid"
  fi

  # Prefer mosh when available on both sides (marker written by `agr install`):
  # it survives drops/roaming/sleep instead of dying on a corrupted SSH packet.
  # Not exec'd, so the terminal-reset guard below always runs. mosh-server execs
  # argv directly (no remote shell), so the resolved path + validated args are safe.
  if have mosh && [ -f "$CACHE_DIR/mosh-$host" ]; then
    mosh "$host" -- "$ragr" attach "$name" "$sid" || ret=$?
  else
    ssh -t "$host" -- "$(remote_cmd attach "$name" "$sid")" || ret=$?
  fi

  # After an abrupt drop, tmux's mouse-tracking / bracketed-paste modes may be
  # left on, dumping escape-code garbage into the local shell. Turn them off —
  # but only when stdout is actually a terminal (B6).
  if [ -t 1 ]; then
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?2004l'
    stty sane 2>/dev/null || true
  fi
  return "$ret"
}

# agr up <host>   — ensure the shared control tunnel is running (idempotent).
cmd_up() {
  local host="${1:-}"; [ -n "$host" ] || die "usage: agr up <host>"
  mkdir -p "$CACHE_DIR"
  local pidfile="$CACHE_DIR/bridge-$host.pid"
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
    return 0
  fi

  # Everything that can die or needs the network happens before the lock, so
  # a dead host or a missing/stale remote agr fails loudly here instead of
  # the loser of the lock race waiting 5s for a bridge that will never start.
  local rhome; rhome="$(remote_home "$host")"
  local rsock="$rhome/$REMOTE_SOCK"
  local probe rc=0
  probe="$(ssh "$host" -- 'mkdir -p ~/.cache/agterm; "$HOME/.local/bin/agr" --version 2>/dev/null || echo MISSING')" || rc=$?
  [ "$rc" -eq 0 ] || die "cannot reach '$host'"
  case "$probe" in
    MISSING)        die "agr not installed on '$host' — run: agr install $host";;
    "agr $VERSION") ;;
    agr\ *)         log "agr: version mismatch (local $VERSION, $host ${probe#agr }) — run: agr install $host";;
    *)              die "agr not installed on '$host' — run: agr install $host";;
  esac

  # Reverse-forward the Mac's agterm socket to a fixed remote path.
  # StreamLocalBindUnlink reclaims a stale socket on reconnect / Mac switch.
  local -a opts=(
    -N
    -o ExitOnForwardFailure=yes
    -o StreamLocalBindUnlink=yes
    -o ServerAliveInterval=20
    -o ServerAliveCountMax=3
    -R "${rsock}:$(local_sock)"
  )

  # Lock (B4): mkdir is atomic, so exactly one concurrent `up` starts a
  # bridge. The lock holder's own pid is a poor staleness signal — it's the
  # `agr up` invocation itself, which normally exits within milliseconds of
  # grabbing the lock (it just forks the bridge loop/autossh and returns), so
  # a loser would almost always see it as "dead" despite it having just
  # succeeded. Poll the *bridge*'s pidfile instead — the thing actually being
  # waited on — and only fall back to reclaiming a truly abandoned lock (dead
  # holder, no bridge ever appeared) once that poll times out.
  local lock="$CACHE_DIR/bridge-$host.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    local waited=0
    while [ "$waited" -lt 5 ]; do
      if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
        return 0
      fi
      sleep 1; waited=$((waited + 1))
    done
    local holder; holder="$(cat "$lock/pid" 2>/dev/null || true)"
    if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$lock"
    fi
    if ! mkdir "$lock" 2>/dev/null; then
      log "agr: bridge for '$host' not up yet"
      return 0
    fi
  fi

  echo $$ > "$lock/pid"
  trap 'rm -rf "$lock"' EXIT

  if have autossh; then
    AUTOSSH_PIDFILE="$pidfile" autossh -M 0 -f "${opts[@]}" "$host"
  else
    # No autossh: a minimal background reconnect loop that owns its ssh (B1:
    # TERM/INT kill the child instead of leaving it orphaned), survives the
    # row that started it closing (B2: ignores HUP), logs to a file instead
    # of the tty, and backs off 3s->60s (reset after a connection >30s).
    (
      trap '' HUP
      trap 'kill "${pid:-}" 2>/dev/null || true; exit 0' TERM INT
      local delay=3
      while true; do
        local t0=$SECONDS
        # shellcheck disable=SC2029 # false positive: no remote command here,
        # $host is just the ssh destination, not an interpolated remote string.
        ssh "${opts[@]}" "$host" & pid=$!
        wait "$pid" || true
        if [ $(( SECONDS - t0 )) -gt 30 ]; then
          delay=3
        else
          delay=$(( delay * 2 )); [ "$delay" -le 60 ] || delay=60
        fi
        sleep "$delay"
      done
    ) >"$CACHE_DIR/bridge-$host.log" 2>&1 </dev/null &
    echo $! > "$pidfile"
  fi

  rm -rf "$lock"; trap - EXIT
  log "agr: bridge up for '$host'"
}

# agr down <host> — stop the control tunnel.
cmd_down() {
  local host="${1:-}"; [ -n "$host" ] || die "usage: agr down <host>"
  local pidfile="$CACHE_DIR/bridge-$host.pid"
  if [ -f "$pidfile" ]; then
    kill "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null || true
    rm -f "$pidfile"
    log "agr: bridge down for '$host'"
  fi
  rm -rf "$CACHE_DIR/bridge-$host.lock"
}

# agr install <host> — copy this script to the remote and wire agent hooks.
cmd_install() {
  local host="${1:-}"; [ -n "$host" ] || die "usage: agr install <host>"
  local self; self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  ssh "$host" 'mkdir -p ~/.local/bin ~/.cache/agterm'
  scp -q "$self" "$host:$REMOTE_BIN.tmp"
  ssh "$host" -- 'chmod +x "$HOME/.local/bin/agr.tmp" && mv -f "$HOME/.local/bin/agr.tmp" "$HOME/.local/bin/agr"'

  # Record whether the remote has mosh, so `agr open` can prefer it.
  mkdir -p "$CACHE_DIR"
  if ssh "$host" 'command -v mosh-server >/dev/null 2>&1'; then
    touch "$CACHE_DIR/mosh-$host"; log "agr: mosh found on '$host' (agr open will use it)"
  else
    rm -f "$CACHE_DIR/mosh-$host"
  fi

  # Merge the four agterm hooks into the remote ~/.claude/settings.json.
  ssh "$host" 'python3 - ' <<'PY'
import json, os, shutil, sys
p = os.path.expanduser("~/.claude/settings.json")
cfg = {}
if os.path.exists(p):
    with open(p) as f:
        try:
            cfg = json.load(f)
        except Exception as e:
            print(f"agr: cannot parse ~/.claude/settings.json: {e}", file=sys.stderr)
            sys.exit(1)
agr = "$HOME/.local/bin/agr status"
wanted = {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": f"{agr} active --blink"}]}],
    "PostToolUse":      [{"hooks": [{"type": "command", "command": f"{agr} active --blink"}]}],
    "Notification":     [{"matcher": "permission_prompt",
                          "hooks": [{"type": "command", "command": f"{agr} blocked"}]}],
    "Stop":             [{"hooks": [{"type": "command", "command": f"{agr} completed --auto-reset"}]}],
}
hooks = cfg.setdefault("hooks", {})
changed = False
for event, entries in wanted.items():
    bucket = hooks.setdefault(event, [])
    # idempotent: skip if any entry already calls `agr status`
    flat = json.dumps(bucket)
    if "agr status" in flat:
        continue
    bucket.extend(entries)
    changed = True
if not changed:
    print("agr: Claude Code hooks already wired in", p)
    sys.exit(0)
os.makedirs(os.path.dirname(p), exist_ok=True)
if os.path.exists(p):
    shutil.copy2(p, p + ".bak-agr")
tmp = p + ".tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f, indent=2)
os.replace(tmp, p)
print("agr: wired Claude Code hooks in", p)
PY
  log "agr: installed $VERSION on '$host'"
}

# agr quick [session-id] — remote-aware quick terminal.
# If the active agterm session was opened by `agr open`, drop a floating remote
# shell overlay on it; otherwise fall back to agterm's built-in local quick
# terminal. Bind this to ctrl+` in keymap.conf (see README).
cmd_quick() {
  have agtermctl || die "agtermctl not found (Mac/agterm only)"
  local id="${1:-}" host=""
  # Resolve the active session id when the keymap didn't pass one.
  if [ -z "$id" ]; then
    id="$(agtermctl tree --json 2>/dev/null | python3 -c '
import sys, json
try:
    t = json.load(sys.stdin)["result"]["tree"]
except Exception:
    sys.exit(0)
wss = t.get("workspaces", [])
for ws in sorted(wss, key=lambda w: not w.get("active")):   # active workspace first
    for s in ws.get("sessions", []):
        if s.get("active"):
            print(s["id"]); sys.exit(0)
' 2>/dev/null)"
  fi
  [ -n "$id" ] && host="$(cat "$CACHE_DIR/session-host/$id" 2>/dev/null || true)"

  if [ -n "$host" ]; then
    # Remote session → floating remote shell on this row (falls back to local
    # quick terminal if the overlay can't open).
    agtermctl session overlay open "ssh -t $host" --target "$id" --size-percent 60 >/dev/null 2>&1 \
      || agtermctl quick toggle >/dev/null 2>&1
  else
    agtermctl quick toggle >/dev/null 2>&1
  fi
}

# agr ls <host> — list agr-owned tmux sessions on <host>. Never mutates.
cmd_ls() {
  local host="${1:-}"; [ -n "$host" ] || die "usage: agr ls <host>"
  local rows; rows="$(remote_data "$host" sessions)" || exit $?
  [ -n "$rows" ] || { echo "no agr sessions on '$host'"; return 0; }

  compute_agr_tree

  printf '%-16s %-4s %-4s %-6s %-16s %s\n' NAME WIN ATT IDLE CMD ROW
  local name windows attached idle_secs cmds sid att
  while IFS=$'\t' read -r name windows attached idle_secs cmds sid; do
    att="$attached"; [ "$att" != "0" ] || att="-"
    printf '%-16s %-4s %-4s %-6s %-16s %s\n' \
      "$name" "$windows" "$att" "$(humanize_secs "$idle_secs")" "$cmds" "$(row_state "$sid")"
  done <<< "$rows"
}

# agr kill <host> <name>... — kill one or more agr-owned tmux sessions on <host>.
cmd_kill() {
  local host="${1:-}"; shift || true
  [ -n "$host" ] && [ "$#" -ge 1 ] || die "usage: agr kill <host> <name>..."
  local name failed=0
  for name in "$@"; do
    valid_token "$name" || { log "agr: invalid name '$name' (use [A-Za-z0-9_.-])"; failed=1; continue; }
    ( remote_data "$host" reap "$name" ) || failed=1
  done
  return "$failed"
}

# agr doctor <host> — check prerequisites on both sides, plus the version
# handshake and bridge socket (constant remote script — no interpolation).
cmd_doctor() {
  local host="${1:-}"; [ -n "$host" ] || die "usage: agr doctor <host>"
  echo "local (agterm host):"
  printf '  agr local     : %s\n' "$VERSION"
  printf '  agterm socket : %s\n' "$([ -S "$(local_sock)" ] && echo present || echo MISSING)"
  printf '  agtermctl     : %s\n' "$(have agtermctl && echo yes || echo 'no (row auto-label disabled)')"
  printf '  autossh       : %s\n' "$(have autossh && echo yes || echo 'no (using reconnect loop)')"
  printf '  mosh          : %s\n' "$(have mosh && echo yes || echo 'no (ssh only)')"
  echo "remote ($host):"
  local remote rc=0
  remote="$(ssh "$host" -- '
    printf "tmux\t%s\n" "$(tmux -V 2>/dev/null || echo MISSING)"
    printf "python3\t%s\n" "$(command -v python3 >/dev/null && python3 -V 2>&1 || echo MISSING)"
    printf "mosh-server\t%s\n" "$(command -v mosh-server >/dev/null && echo yes || echo no)"
    printf "agr\t%s\n" "$("$HOME/.local/bin/agr" --version 2>/dev/null || echo MISSING)"
    printf "socket\t%s\n" "$([ -S ~/.cache/agterm/agterm.sock ] && echo present || echo MISSING)"
    printf "legacy\t%s\n" "$(ls ~/.cache/agterm/targets 2>/dev/null | tr "\n" " ")"
  ')" || rc=$?
  [ "$rc" -eq 0 ] || die "cannot reach '$host'"
  local key val agr_ver="" legacy=""
  while IFS=$'\t' read -r key val; do
    case "$key" in
      tmux)        printf '  tmux          : %s\n' "$val";;
      python3)     printf '  python3       : %s\n' "$val";;
      mosh-server) printf '  mosh-server   : %s\n' "$([ "$val" = yes ] && echo yes || echo 'no (ssh only)')";;
      agr)         agr_ver="$val";;
      socket)      printf '  bridge socket : %s\n' "$val";;
      legacy)      legacy="$val";;
    esac
  done <<< "$remote"
  case "$agr_ver" in
    MISSING) printf '  agr remote    : MISSING ← run: agr install %s\n' "$host";;
    "$VERSION") printf '  agr remote    : %s\n' "$agr_ver";;
    *) printf '  agr remote    : %s ← run: agr install %s\n' "$agr_ver" "$host";;
  esac
  if [ -n "$legacy" ]; then
    printf '  legacy targets: %s — agr open each to adopt, then rm -r ~/.cache/agterm/targets\n' "$legacy"
  else
    printf '  legacy targets: none\n'
  fi
}

# ---------------------------------------------------------------------------
# REMOTE subcommands (invoked over SSH / by Claude Code hooks)
# ---------------------------------------------------------------------------

# agr attach <name> [agterm-session-id]
# Mark the tmux session as agr-owned (@agr_target = the row id, or "-" when
# opened outside agterm), then attach-or-create it.
cmd_attach() {
  local name="${1:-}" sid="${2:-}"
  [ -n "$name" ] || die "usage: agr attach <name> [session-id]"
  valid_token "$name" || die "invalid name '$name' (use [A-Za-z0-9_.-])"
  [ -z "$sid" ] || valid_token "$sid" || die "invalid session-id '$sid' (use [A-Za-z0-9_.-])"
  tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name"
  tmux set-option -t "=$name:" @agr_target "${sid:--}"
  exec tmux attach -t "=$name"
}

# agr sessions
# Remote producer: list agr-owned tmux sessions as TSV for `agr ls`. This is a
# data-returning command, so it starts with the version handshake header.
cmd_sessions() {
  have tmux || die "tmux not found in non-interactive PATH"
  printf 'agr\t%s\n' "$VERSION"
  local list
  list="$(tmux list-sessions -F $'#{session_name}\t#{session_windows}\t#{session_attached}\t#{session_activity}\t#{@agr_target}' 2>/dev/null)" || exit 0
  [ -n "$list" ] || exit 0
  local name windows attached activity target
  while IFS=$'\t' read -r name windows attached activity target; do
    [ -n "$target" ] || continue
    local raw filtered cmds idle_secs
    raw="$(tmux list-panes -s -t "=$name" -F '#{pane_current_command}' 2>/dev/null | sort -u)" || true
    # Drop plain shells from the command list; if that empties it, keep them
    # (a session with only a shell running should still show something).
    filtered="$(printf '%s\n' "$raw" | grep -vE '^(sh|bash|zsh|fish|dash)$' || true)"
    if [ -n "$filtered" ]; then cmds="$filtered"; else cmds="$raw"; fi
    cmds="$(printf '%s' "$cmds" | tr '\n' ',' | sed 's/,$//')"
    [ -n "$cmds" ] || cmds="-"
    idle_secs=$(( $(date +%s) - activity ))
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$windows" "$attached" "$idle_secs" "$cmds" "$target"
  done <<< "$list"
}

# agr reap <name>
# Remote: kill an agr-owned tmux session. Refuses to touch a tmux session that
# was not created by `agr attach` (no @agr_target set). Data-returning, so it
# starts with the version handshake header.
cmd_reap() {
  have tmux || die "tmux not found in non-interactive PATH"
  printf 'agr\t%s\n' "$VERSION"
  local name="${1:-}"
  valid_token "$name" || die "invalid name '$name' (use [A-Za-z0-9_.-])"
  tmux has-session -t "=$name" 2>/dev/null || die "no session '$name'"
  local target; target="$(tmux show-option -t "=$name:" -qv @agr_target 2>/dev/null)" || true
  [ -n "$target" ] || die "'$name' exists but is not agr-managed (use tmux kill-session)"
  tmux kill-session -t "=$name"
  echo "killed $name"
}

# agr status <state> [--blink] [--auto-reset]
# Hook entry point: resolve this tmux session's target row, then relay.
# Always a no-op (exit 0) when there is nothing to do, so it can never block a turn.
cmd_status() {
  local state="${1:-}"; [ -n "$state" ] || exit 0; shift || true
  [ -n "${TMUX_PANE:-}" ] || exit 0
  local target; target="$(tmux display-message -p -t "$TMUX_PANE" '#{@agr_target}' 2>/dev/null)" || exit 0
  [ -n "$target" ] && [ "$target" != "-" ] || exit 0
  local sock="$HOME/$REMOTE_SOCK"
  [ -S "$sock" ] || exit 0
  cmd_relay "$state" "$target" "$sock" "$@" || true
  exit 0
}

# agr relay <state> <target> <socket> [--blink] [--auto-reset]
# Pure transport: write one line of JSON to the forwarded agterm control socket.
# 0.3s timeout means a stale-but-present socket can never hang the caller.
cmd_relay() {
  local state="${1:-}" target="${2:-}" sock="${3:-}"; shift 3 2>/dev/null || true
  [ -n "$state" ] && [ -n "$target" ] && [ -n "$sock" ] || return 0
  local blink=false auto=false a
  for a in "$@"; do
    case "$a" in --blink) blink=true;; --auto-reset) auto=true;; esac
  done
  AGR_STATE="$state" AGR_TARGET="$target" AGR_SOCK="$sock" AGR_BLINK="$blink" AGR_AUTO="$auto" \
  python3 - <<'PY' 2>/dev/null || true
import os, socket, json
m = {"args": {"status": os.environ["AGR_STATE"]},
     "target": os.environ["AGR_TARGET"], "cmd": "session.status"}
if os.environ.get("AGR_BLINK") == "true": m["args"]["blink"] = True
if os.environ.get("AGR_AUTO")  == "true": m["args"]["autoReset"] = True
try:
    s = socket.socket(socket.AF_UNIX); s.settimeout(0.3)
    s.connect(os.environ["AGR_SOCK"])
    s.sendall((json.dumps(m) + "\n").encode())
except OSError:
    pass
PY
}

usage() {
  cat >&2 <<EOF
agr $VERSION — agterm-remote

Mac (agterm) commands:
  agr open <host> [name]   adopt the current agterm session -> remote tmux <name>
                           (no name: pick from owned sessions, or type a new one)
  agr ls <host>            list agr-owned tmux sessions on <host>
  agr kill <host> <name>.. kill one or more agr-owned tmux sessions on <host>
  agr up <host>            ensure the control tunnel (idempotent)
  agr down <host>          stop the control tunnel
  agr install <host>       copy agr to <host> and wire Claude Code hooks
  agr quick [session-id]   remote-aware quick terminal (bind to ctrl+\`)
  agr doctor <host>        check prerequisites on both sides

Remote commands (usually invoked by ssh / hooks, not by hand):
  agr attach <name> [id]   record target id, tmux new-session -A -s <name>
  agr sessions             list agr-owned tmux sessions as TSV (for agr ls)
  agr reap <name>          kill an agr-owned tmux session (for agr kill)
  agr status <state> ...   hook entry point (active|blocked|completed)
  agr relay <state> <target> <socket> ...   send one status message
EOF
  exit "${1:-1}"
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    open)    cmd_open    "$@";;
    up)      cmd_up      "$@";;
    down)    cmd_down    "$@";;
    install) cmd_install "$@";;
    quick)   cmd_quick   "$@";;
    doctor)  cmd_doctor  "$@";;
    ls)      cmd_ls      "$@";;
    kill)    cmd_kill    "$@";;
    attach)  cmd_attach  "$@";;
    sessions) cmd_sessions "$@";;
    reap)    cmd_reap    "$@";;
    status)  cmd_status  "$@";;
    relay)   cmd_relay   "$@";;
    -V|--version) echo "agr $VERSION";;
    ''|-h|--help) usage 0;;
    *) log "agr: unknown command '$sub'"; usage 1;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
